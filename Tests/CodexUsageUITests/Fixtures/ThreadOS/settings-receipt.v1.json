{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threados.settings-receipt.v1",
  "oneOf": [
    {"$ref": "#/$defs/config"}, {"$ref": "#/$defs/mode"}, {"$ref": "#/$defs/waveStart"}, {"$ref": "#/$defs/waveFinish"}, {"$ref": "#/$defs/status"}, {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "base": {"type": "object", "properties": {"schema": {"const": "threados.settings-receipt.v1"}, "protocol": {"const": "TOSACK/1"}, "authority": {"const": "settings_do_not_grant_authority"}}, "required": ["schema", "protocol", "authority"]},
    "role": {"type":"object","additionalProperties":false,"required":["requested_model","configured_model","reasoning_effort","effective_observed","native_status"],"properties":{"requested_model":{"enum":["gpt-5.6-terra","gpt-6-astra"]},"configured_model":{"enum":["gpt-5.6-terra","gpt-6-astra"]},"reasoning_effort":{"enum":["low","medium","high","xhigh","max","ultra"]},"effective_observed":{"const":"unknown"},"native_status":{"enum":["pending_native_selection","unsupported"]}}},
    "roles": {"type":"object","additionalProperties":false,"required":["LEADER","QA","FOREMAN","CODING_WORKER","REVIEWER"],"properties":{"LEADER":{"$ref":"#/$defs/role"},"QA":{"$ref":"#/$defs/role"},"FOREMAN":{"$ref":"#/$defs/role"},"CODING_WORKER":{"$ref":"#/$defs/role"},"REVIEWER":{"$ref":"#/$defs/role"}}},
    "view": {"type": "object", "additionalProperties": false, "required": ["catalog_revision", "preset", "roles", "coding_workers", "review_workers", "tier", "apply"], "properties": {"catalog_revision": {"const":"astra-20260904.1"}, "preset": {"enum":["astra-economy","astra-balanced","astra-speed","astra-deep","custom"]}, "roles": {"$ref":"#/$defs/roles"}, "coding_workers": {"type":"integer","minimum":1,"maximum":4}, "review_workers": {"type":"integer","minimum":1,"maximum":4}, "tier": {"enum": ["standard", "priority"]}, "apply": {"const": "next-wave"}}},
    "waveId": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "config": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["status", "effective_from", "id", "rev", "preset", "requested", "configured", "effective_observed", "pending_native"], "properties": {"schema": true, "protocol": true, "authority": true, "status": {"const": "pending_native_selection"}, "effective_from": {"const": "next-wave"}, "id": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"}, "rev": {"type":"integer","minimum":1,"maximum":1000000}, "preset": {"enum":["astra-economy","astra-balanced","astra-speed","astra-deep","custom"]}, "requested": {"$ref": "#/$defs/view"}, "configured": {"$ref": "#/$defs/view"}, "effective_observed": {"const": "unknown"}, "pending_native": {"type":"array","minItems":5,"maxItems":5,"prefixItems":[{"const":"CODING_WORKER"},{"const":"FOREMAN"},{"const":"LEADER"},{"const":"QA"},{"const":"REVIEWER"}],"items":false}}}]},
    "mode": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["status", "mode", "effective_from"], "properties": {"schema": true, "protocol": true, "authority": true, "status": {"enum": ["mode_updated", "mode_queued"]}, "mode": {"enum": ["on", "off"]}, "effective_from": {"enum": ["idle", "observed"]}}}, {"anyOf":[{"properties":{"status":{"const":"mode_updated"},"effective_from":{"const":"observed"}}},{"properties":{"status":{"const":"mode_queued"},"mode":{"const":"off"},"effective_from":{"const":"idle"}}}]}]},
    "waveStart": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["status", "wave_id", "configured"], "properties": {"schema": true, "protocol": true, "authority": true, "status": {"const": "wave_started"}, "wave_id": {"$ref":"#/$defs/waveId"}, "configured": {"$ref":"#/$defs/view"}}}]},
    "waveFinish": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["status", "wave_id", "mode"], "properties": {"schema": true, "protocol": true, "authority": true, "status": {"const": "wave_finished"}, "wave_id": {"$ref":"#/$defs/waveId"}, "mode": {"enum": ["on", "off"]}}}]},
    "runningWave": {"type":"object","additionalProperties":false,"required":["wave_id","config"],"properties":{"wave_id":{"$ref":"#/$defs/waveId"},"config":{"$ref":"#/$defs/view"}}},
    "status": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["status", "mode", "pending_mode", "active", "pending", "running_wave"], "properties": {"schema": true, "protocol": true, "authority": true, "status": {"const": "status"}, "mode": {"enum": ["on", "off"]}, "pending_mode": {"enum": [null, "off"]}, "active": {"anyOf": [{"$ref": "#/$defs/view"}, {"type": "null"}]}, "pending": {"anyOf": [{"$ref": "#/$defs/view"}, {"type": "null"}]}, "running_wave": {"anyOf":[{"$ref":"#/$defs/runningWave"},{"type":"null"}]}}}]},
    "error": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["status", "error"], "properties": {"schema": true, "protocol": true, "authority": true, "status": {"const": "error"}, "error": {"type": "string", "pattern":"^[A-Z][A-Z0-9_]{0,63}$"}}}]}
  }
}
