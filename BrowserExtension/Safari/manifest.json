{
  "manifest_version": 2,
  "name": "UMA Browser Companion for Claude",
  "version": "1.4.0",
  "description": "Sends normalized Claude plan-limit percentages from the exact official Usage route to UMA.",
  "permissions": [
    "nativeMessaging",
    "https://claude.ai/new*",
    "https://gemini.google.com/usage*"
  ],
  "icons": {
    "48": "icons/extension-48.png",
    "96": "icons/extension-96.png",
    "128": "icons/extension-128.png",
    "256": "icons/extension-256.png",
    "512": "icons/extension-512.png"
  },
  "browser_action": {
    "default_title": "AUV — syncs Claude usage automatically",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "32": "icons/toolbar-32.png",
      "38": "icons/toolbar-38.png",
      "48": "icons/toolbar-48.png"
    }
  },
  "background": {
    "scripts": [
      "Shared/claude-usage-extractor.js",
      "Shared/gemini-usage-extractor.js",
      "Shared/provider-ownership-v2.js",
      "Shared/owned-provider-tab-v2-reducer.js",
      "Safari/background-loader.js",
      "Shared/background-core.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/new*"
      ],
      "js": [
        "Shared/claude-usage-extractor.js",
        "Shared/provider-ownership-v2.js",
        "Shared/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://gemini.google.com/usage*"
      ],
      "js": [
        "Shared/claude-usage-extractor.js",
        "Shared/gemini-usage-extractor.js",
        "Shared/provider-ownership-v2.js",
        "Shared/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
