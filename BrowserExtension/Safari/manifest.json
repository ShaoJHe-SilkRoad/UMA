{
  "manifest_version": 2,
  "name": "UMA Browser Companion for Claude",
  "version": "1.4.0",
  "description": "Sends normalized Claude plan-limit percentages from the exact official Usage route to UMA.",
  "permissions": ["nativeMessaging", "https://claude.ai/new*"],
  "background": {
    "scripts": [
      "Shared/claude-usage-extractor.js",
      "Shared/provider-ownership-v2.js",
      "Shared/owned-provider-tab-v2-reducer.js",
      "Safari/background-loader.js",
      "Shared/background-core.js"
    ],
    "persistent": true
  },
  "content_scripts": [{
    "matches": ["https://claude.ai/new*"],
    "js": [
      "Shared/claude-usage-extractor.js",
      "Shared/provider-ownership-v2.js",
      "Shared/content-script.js"
    ],
    "run_at": "document_start",
    "all_frames": false
  }]
}
