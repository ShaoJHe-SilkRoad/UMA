<Window Style="{StaticResource {x:Type Window}}" x:Class="AUV.Windows.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AUV.Windows.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="{Binding WindowTitle}" Width="1056" Height="800" MinWidth="760" MinHeight="500" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="auv.main">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><local:SectionConverter x:Key="Section"/><BooleanToVisibilityConverter x:Key="Visible"/><local:InverseVisibilityConverter x:Key="InverseVisible"/><local:EffortLabelConverter x:Key="EffortLabel"/>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="52"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MaximizeCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
   <Setter Property="ToolTip" Value="Maximize"/><Setter Property="AutomationProperties.Name" Value="Maximize"/>
   <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="ToolTip" Value="Restore"/><Setter Property="AutomationProperties.Name" Value="Restore"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="CaptionGlyph" TargetType="Path"><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="StrokeThickness" Value="1"/><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="Stretch" Value="Uniform"/></Style>
  <Style x:Key="FooterButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="FooterWizardButton" TargetType="Button" BasedOn="{StaticResource FooterButton}"><Style.Triggers><DataTrigger Binding="{Binding Desktop.WidgetRequested, Source={x:Static Application.Current}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="FooterGlyph" TargetType="Path"><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="StrokeThickness" Value="1.4"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/></Style>
 </Window.Resources>
 <DockPanel x:Name="RootLayout" Background="{DynamicResource CanvasBrush}">
  <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
   <Grid x:Name="TitleBar" Height="52" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <RadioButton Content="_AUV" Style="{StaticResource NavButton}" GroupName="Sections" IsChecked="{Binding Shell.Section, Converter={StaticResource Section}, ConverterParameter=AUV, Mode=TwoWay}" AutomationProperties.AutomationId="auv.nav.auv"/>
     <RadioButton Content="{local:Tr _Sectorium, _Sectorium（分区工）}" Style="{StaticResource NavButton}" GroupName="Sections" IsChecked="{Binding Shell.Section, Converter={StaticResource Section}, ConverterParameter=Sectorium, Mode=TwoWay}" AutomationProperties.AutomationId="auv.nav.sectorium"/>
     <Button x:Name="BackToCodex" Content="{local:Tr '‹  Back to Codex', '‹  返回 Codex'}" Click="BackToCodex_Click" Margin="12,0,0,0" Visibility="{Binding Shell.Section, Converter={StaticResource Section}, ConverterParameter=ThreadOS}" AutomationProperties.AutomationId="auv.threados.back"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="{Binding Providers.RefreshLabel, Source={x:Static Application.Current}}" Click="RefreshAll_Click" ToolTip="{local:Tr 'Refresh every agent · F5', '刷新所有智能体 · F5'}" AutomationProperties.AutomationId="auv.refresh.all"/>
     <Button Content="{local:Tr Settings, 设置}" Click="GlobalSettings_Click" Margin="8,0,0,0" ToolTip="Ctrl+," AutomationProperties.AutomationId="auv.settings"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
     <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="{local:Tr Minimize, 最小化}" AutomationProperties.Name="Minimize" AutomationProperties.AutomationId="auv.window.minimize"><Path Style="{StaticResource CaptionGlyph}" Data="M0,5 L10,5" Height="1"/></Button>
     <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="MaximizeRestore_Click" AutomationProperties.AutomationId="auv.window.maximize"><Path><Path.Style><Style TargetType="Path" BasedOn="{StaticResource CaptionGlyph}"><Setter Property="Data" Value="M0,0 L10,0 10,10 0,10 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M3,0 L10,0 10,7 M0,3 L7,3 7,10 0,10 Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
     <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="{local:Tr Close, 关闭}" AutomationProperties.Name="Close" AutomationProperties.AutomationId="auv.window.close"><Path Style="{StaticResource CaptionGlyph}" Data="M0,0 L10,10 M0,10 L10,0"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,4">
   <Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button Style="{StaticResource FooterButton}" Click="UsagePopup_Click" ToolTip="{local:Tr 'Tray usage panel · Ctrl+Shift+U', '托盘用量面板 · Ctrl+Shift+U'}" AutomationProperties.Name="Usage popup" AutomationProperties.AutomationId="auv.desktop.usage"><Path Style="{StaticResource FooterGlyph}" Data="M2,13 L2,9 M7,13 L7,5 M12,13 L12,1 M0,15 L15,15"/></Button>
     <Button Style="{StaticResource FooterWizardButton}" Click="Widget_Click" ToolTip="{local:Tr 'Desktop Wizard · Ctrl+Shift+W', '桌面浮窗 · Ctrl+Shift+W'}" AutomationProperties.Name="Desktop Wizard" AutomationProperties.AutomationId="auv.desktop.toggle"><Path Style="{StaticResource FooterGlyph}" Data="M2,2 L14,2 14,11 2,11 Z M6,11 L6,14 M10,11 L10,14 M4,14 L12,14"/></Button>
     <Button Style="{StaticResource FooterButton}" Click="RefreshAll_Click" ToolTip="{local:Tr 'Refresh All · F5', '全部刷新 · F5'}" AutomationProperties.Name="Refresh All" AutomationProperties.AutomationId="auv.usage.refresh"><Path Style="{StaticResource FooterGlyph}" Data="M13,5 A6,6 0 1 0 14,10 M13,1 L13,5 9,5"/></Button>
     <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="6,0"/>
     <Button Style="{StaticResource FooterButton}" Click="MoreActions_Click" ToolTip="{local:Tr 'More actions', '更多操作'}" AutomationProperties.Name="More actions" AutomationProperties.AutomationId="auv.desktop.more">
      <Button.ContextMenu><ContextMenu Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"><MenuItem Header="{local:Tr 'Hide to system tray', '隐藏到系统托盘'}" Click="HideToTray_Click" AutomationProperties.AutomationId="auv.desktop.hide"/><Separator/><MenuItem Header="{local:Tr 'Quit AUV', '退出 AUV'}" Click="Exit_Click" AutomationProperties.AutomationId="auv.desktop.exit"/></ContextMenu></Button.ContextMenu>
      <Path Style="{StaticResource FooterGlyph}" Data="M2,7 L2,7.1 M8,7 L8,7.1 M14,7 L14,7.1" StrokeThickness="2.8"/>
     </Button>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Top" Padding="16,4" Visibility="{Binding Demo, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Mode}" Foreground="{DynamicResource WarningBrush}" FontSize="12"/></Border>
  <Grid>
   <Grid Visibility="{Binding Shell.Section, Converter={StaticResource Section}, ConverterParameter=AUV}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource SurfaceBrush}">
     <DockPanel Margin="8,12">
      <StackPanel DockPanel.Dock="Top" Margin="6,0,4,10"><TextBlock Text="{local:Tr Agents, 智能体}" Style="{StaticResource CardTitle}" Margin="0"/><TextBlock Text="{local:Tr 'Drag to arrange · Alt+↑/↓', '拖动排序 · Alt+↑/↓'}" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
      <ListBox x:Name="AgentRail" ItemsSource="{Binding Shell.Agents}" SelectedItem="{Binding Shell.SelectedAgent, Mode=TwoWay}" AllowDrop="True" PreviewMouseLeftButtonDown="Rail_PreviewMouseLeftButtonDown" PreviewMouseMove="Rail_PreviewMouseMove" DragOver="Rail_DragOver" Drop="Rail_Drop" PreviewKeyDown="Rail_PreviewKeyDown" AutomationProperties.Name="Agents" AutomationProperties.AutomationId="auv.agents" KeyboardNavigation.TabNavigation="Once">
       <ListBox.ItemTemplate><DataTemplate><local:AllowanceRow x:Name="ProviderRow" ShowFill="{Binding Desktop.ShowFill, Source={x:Static Application.Current}}" ShowStatus="{Binding Desktop.ShowStatus, Source={x:Static Application.Current}}" Card="{Binding Card}" MinHeight="0"><local:AllowanceRow.Style><Style TargetType="{x:Type local:AllowanceRow}"><Setter Property="Height" Value="64"/><Style.Triggers><DataTrigger Binding="{Binding Card.HasDisplayableQuota}" Value="False"><Setter Property="Height" Value="36"/></DataTrigger></Style.Triggers></Style></local:AllowanceRow.Style></local:AllowanceRow></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14,20,16">
     <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{Binding Shell.SelectedAgent.Name}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding SelectedCard.Plan}" Visibility="{Binding HasPlan, Converter={StaticResource Visible}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
       <Button Grid.Column="1" Content="{Binding SettingsButton}" Click="AgentSettings_Click" VerticalAlignment="Center" AutomationProperties.AutomationId="auv.detail.settings"/>
      </Grid>
      <!-- Usage -->
      <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="auv.card.usage">
       <StackPanel>
        <TextBlock Text="{local:Tr Usage, 用量}" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="{Binding NoQuotaText}" Style="{StaticResource Muted}" Visibility="{Binding HasUsage, Converter={StaticResource InverseVisible}}"/>
        <local:ClaudeConnectPanel Margin="0,10,0,4" Visibility="{Binding IsClaude, Converter={StaticResource Visible}}"/>
        <ItemsControl ItemsSource="{Binding UsageRows}" Visibility="{Binding HasUsage, Converter={StaticResource Visible}}" AutomationProperties.Name="Quota windows">
         <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12" ToolTip="{Binding Card.Description}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" VerticalAlignment="Bottom"/><TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Metric}"/></Grid>
          <local:DetailQuotaBar Card="{Binding Card}" Margin="0,6,0,4" Visibility="{Binding HasBar, Converter={StaticResource Visible}}"/>
          <TextBlock Text="{Binding Reset}" Style="{StaticResource Caption}"/>
         </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel Visibility="{Binding HasTokenMetrics, Converter={StaticResource Visible}}" Margin="0,4,0,0">
         <StackPanel MinWidth="170" Margin="0,0,24,8" Visibility="{Binding HasWeekTokens, Converter={StaticResource Visible}}" ToolTip="{local:Tr 'Account tokens', '账户令牌'}"><TextBlock Text="{local:Tr 'Account 7D tokens', '账户 7 天令牌'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding WeekTokens}" Style="{StaticResource Metric}" Margin="0,2,0,0"/></StackPanel>
         <StackPanel MinWidth="170" Margin="0,0,0,8" Visibility="{Binding HasLifetimeTokens, Converter={StaticResource Visible}}" ToolTip="{local:Tr 'Account tokens', '账户令牌'}"><TextBlock Text="{local:Tr 'Account lifetime tokens', '账户累计令牌'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding LifetimeTokens}" Style="{StaticResource Metric}" Margin="0,2,0,0"/></StackPanel>
        </WrapPanel>
        <StackPanel Visibility="{Binding HasChart, Converter={StaticResource Visible}}" Margin="0,8,0,0">
         <TextBlock Text="{Binding ChartHeading}" Style="{StaticResource Muted}" Margin="0,0,0,8" ToolTip="{Binding ChartSummary}"/>
         <Border Height="140" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <ItemsControl ItemsSource="{Binding Bars}" AutomationProperties.Name="Daily tokens, seven days"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="4,0" AutomationProperties.Name="{Binding Description}" ToolTip="{Binding Description}"><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="24"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Bottom"><TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/><Border Height="{Binding Height}" MaxWidth="44" MaxHeight="92" Background="{DynamicResource ChartBrush}" CornerRadius="3,3,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </Border>
        </StackPanel>
       </StackPanel>
      </Border>
      <!-- Connection & Source -->
      <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="auv.card.connection">
       <StackPanel><TextBlock Text="{local:Tr 'Connection &amp; Source', 连接与来源}" Style="{StaticResource CardTitle}"/>
        <ItemsControl ItemsSource="{Binding ConnectionRows}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Value}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding Activity}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <!-- Local Cost Estimate (switch off by default; hidden while off) -->
      <Border Style="{StaticResource Card}" Visibility="{Binding HasLocalCost, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="auv.card.cost">
       <StackPanel><TextBlock Text="{local:Tr 'Local Cost Estimate', 本地费用估算}" Style="{StaticResource CardTitle}"/>
        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{local:Tr 'Last 7 days', 近 7 天}" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LocalCost}" FontWeight="SemiBold"/></Grid>
        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{local:Tr Lifetime, 累计}" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LifetimeCost}" FontWeight="SemiBold"/></Grid>
        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{local:Tr 'Priced coverage', 计价覆盖率}" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding CostCoverage}" FontWeight="SemiBold"/></Grid>
        <TextBlock Text="{local:Tr 'None of the models in local Codex activity are in the public price table yet, so no amount is shown.', '本地 Codex 活动中的模型都还不在公开价目表中，因此不显示金额。'}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Visibility="{Binding CostHasNoPricedModels, Converter={StaticResource Visible}}" Margin="0,2,0,6"/>
        <TextBlock Text="{local:Tr 'API-equivalent, from local token totals and public list prices. Not a bill; no billing data is read.', '按本地令牌总量与公开价目表折算的 API 等效金额。并非账单，不读取任何账单信息。'}" Style="{StaticResource Caption}"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <ScrollViewer Visibility="{Binding Shell.Section, Converter={StaticResource Section}, ConverterParameter=ThreadOS}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
    <local:AdaptiveWorkbench>
     <StackPanel><TextBlock Text="{local:Tr ThreadOS, ThreadOS（线程工）}" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/><TextBlock Text="{local:Tr 'Choose models and thinking levels for your coding team.', '为开发团队选择模型与思考档位。'}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
      <ItemsControl ItemsSource="{Binding Roles}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Tr Model, 模型}" Style="{StaticResource Caption}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model, Mode=TwoWay}" AutomationProperties.Name="{Binding Label, StringFormat={}{0} model}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{local:Tr Thinking, 思考档位}" Style="{StaticResource Caption}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort, Mode=TwoWay}" AutomationProperties.Name="{Binding Label, StringFormat={}{0} thinking}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource EffortLabel}"><Binding/><Binding Path="Language" Source="{x:Static local:Loc.Instance}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Grid></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{local:Tr 'Catalog: sol-luna-ultra-20261010.1', '模型目录：sol-luna-ultra-20261010.1'}" Style="{StaticResource Caption}"/>
      <TextBlock Text="{local:Tr 'Ultra · ? — availability on the receiving host is not verified. The receiving client must verify it.', '超高 · ? —— 接收端是否支持未经核实，须由接收客户端验证。'}" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel><TextBlock Text="{local:Tr 'Instruction preview', 指令预览}" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Generated, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="300" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Generated instruction" AutomationProperties.AutomationId="threados.preview"/>
      <WrapPanel Margin="0,12,0,0"><Button Content="{local:Tr _Generate, 生成(_G)}" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" AutomationProperties.AutomationId="threados.generate"/><Button Content="{local:Tr _Copy, 复制(_C)}" Command="{Binding CopyCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="threados.copy"/></WrapPanel>
      <TextBlock Text="{Binding InstructionStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{local:Tr 'Choose → Generate → Copy → paste to your receiving Leader. Copy does not apply settings or dispatch work.', '选择 → 生成 → 复制 → 粘贴给接收端 Leader。复制不会应用设置，也不会派发任务。'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
     </StackPanel>
    </local:AdaptiveWorkbench>
   </ScrollViewer>
   <ScrollViewer Visibility="{Binding Shell.Section, Converter={StaticResource Section}, ConverterParameter=Sectorium}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
    <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Tr Sectorium, Sectorium（分区工）}" Style="{StaticResource PageTitle}"/><TextBlock Text="{local:Tr 'Development storage · Windows interface preview', '开发存储 · Windows 界面预览'}" Style="{StaticResource Muted}" Margin="0,4,0,16"/></StackPanel><Button Grid.Column="1" Content="{local:Tr 'Storage settings', 存储设置}" VerticalAlignment="Top" Click="StorageSettings_Click" AutomationProperties.AutomationId="storage.settings"/></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{local:Tr 'Physical drive', 物理磁盘}" Style="{StaticResource SectionTitle}"/><TreeView SelectedItemChanged="StorageSelection_Changed" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8" MinHeight="140" AutomationProperties.Name="Physical drive and associated volume"><TreeView.Resources><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxWidth="158"/></DataTemplate></Setter.Value></Setter></Style></TreeView.Resources><TreeViewItem Header="{Binding Storage.PhysicalDrive}" IsExpanded="True" IsSelected="True"><TreeViewItem Tag="Volume" Header="{Binding Storage.Volume}"/></TreeViewItem></TreeView><TextBlock Text="{local:Tr 'Associated volumes remain under their physical drive.', '关联卷显示在其物理磁盘之下。'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="{Binding Storage.DetailHeading}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Storage.SelectedIdentity}"/><TextBlock Text="{local:Tr 'Installation / configuration', 安装与配置}" Style="{StaticResource Muted}" Margin="0,12,0,4"/><TextBlock Text="{Binding Storage.Installation}"/><TextBlock Text="{local:Tr 'Virtual development volume', 虚拟开发卷}" Style="{StaticResource Muted}" Margin="0,12,0,4"/><TextBlock Text="{Binding Storage.Volume}"/><TextBlock Text="{local:Tr 'Unmounted / unknown · backend unavailable', '未挂载或未知 · 后端不可用'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
     </Grid>
     <Border Style="{StaticResource Divider}"/>
     <WrapPanel ToolTipService.ShowOnDisabled="True" ToolTip="{local:Tr 'Windows storage backend is not implemented.', 'Windows 存储后端尚未实现。'}"><Button Content="{local:Tr 'Install / configure', 安装或配置}" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="sectorium.install"/><Button Content="{local:Tr Mount, 挂载}" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="sectorium.mount"/><Button Content="{local:Tr Start, 启动}" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="sectorium.start"/><Button Content="{local:Tr Stop, 停止}" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="sectorium.stop"/><Button Content="{local:Tr 'Safe eject', 安全弹出}" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.AutomationId="sectorium.eject"/></WrapPanel>
     <TextBlock Text="{Binding Storage.Feedback}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,12" AutomationProperties.LiveSetting="Polite"/>
     <CheckBox Content="DEMO · show synthetic configuration error" IsChecked="{Binding Storage.FixtureError}" Visibility="{Binding Demo, Converter={StaticResource Visible}}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
     <Expander x:Name="StorageTechnical" Header="{local:Tr 'Technical details &amp; diagnostics', 技术细节与诊断}" IsExpanded="True" Foreground="{DynamicResource TextBrush}"><TextBlock Text="{local:Tr 'Backend unavailable. No disk inventory, VHD/VHDX, formatting, mount, eject, encryption or service operation is implemented. macOS APFS images are not treated as Windows-compatible.', '后端不可用。未实现磁盘清单、VHD/VHDX、格式化、挂载、弹出、加密或服务操作。macOS APFS 映像不视为与 Windows 兼容。'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></Expander>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
