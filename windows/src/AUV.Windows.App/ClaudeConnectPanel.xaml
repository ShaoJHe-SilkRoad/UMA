<UserControl x:Class="AUV.Windows.App.ClaudeConnectPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AUV.Windows.App"
             DataContext="{Binding Providers, Source={x:Static Application.Current}}" AutomationProperties.AutomationId="auv.claude.panel">
 <!-- 0.18.6: one panel on the Claude page and in Claude settings. Connect card → three-step checklist → one summary line. -->
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/><local:InverseVisibilityConverter x:Key="InverseVisible"/>
  <Style x:Key="StepDone" TargetType="Border"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Background" Value="{DynamicResource QuotaNormalBrush}"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,1,10,0"/></Style>
  <Style x:Key="StepTodo" TargetType="Border"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="CornerRadius" Value="11"/><Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,1,10,0"/></Style>
  <Style x:Key="Tick" TargetType="TextBlock"><Setter Property="Text" Value="✓"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource CanvasBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Number" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,6,8,0"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="28"/></Style>
 </UserControl.Resources>
 <StackPanel>
  <!-- Connect card -->
  <Border Visibility="{Binding ClaudeShowConnect, Converter={StaticResource Visible}}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,4,0,0" AutomationProperties.AutomationId="auv.claude.connect-card">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
     <TextBlock Text="{local:Tr 'Connect Claude', 连接 Claude}" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding ClaudeConnectText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Content="{Binding ClaudeConnectLabel}" Style="{StaticResource PrimaryButton}" MinWidth="96" VerticalAlignment="Center" IsEnabled="{Binding ClaudeConnectAvailable}" Click="Connect_Click" AutomationProperties.AutomationId="auv.claude.connect"/>
   </Grid>
  </Border>
  <!-- All three steps done: one line -->
  <StackPanel Orientation="Horizontal" Visibility="{Binding ClaudeShowSummary, Converter={StaticResource Visible}}" Margin="0,4,0,0" AutomationProperties.AutomationId="auv.claude.summary">
   <Border Style="{StaticResource StepDone}" Margin="0,0,10,0"><TextBlock Style="{StaticResource Tick}"/></Border>
   <TextBlock Text="{Binding ClaudeSummary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
  </StackPanel>
  <!-- The checklist, ticked as AUV sees each step happen -->
  <StackPanel Visibility="{Binding ClaudeShowChecklist, Converter={StaticResource Visible}}" Margin="0,4,0,0" AutomationProperties.AutomationId="auv.claude.checklist">
   <DockPanel Margin="0,0,0,10" AutomationProperties.AutomationId="auv.claude.step1">
    <Grid DockPanel.Dock="Left"><Border Style="{StaticResource StepDone}" Visibility="{Binding ClaudeStep1Done, Converter={StaticResource Visible}}"><TextBlock Style="{StaticResource Tick}"/></Border><Border Style="{StaticResource StepTodo}" Visibility="{Binding ClaudeStep1Done, Converter={StaticResource InverseVisible}}"><TextBlock Text="1" Style="{StaticResource Number}"/></Border></Grid>
    <TextBlock Text="{local:Tr 'Registered for Chrome and Edge', 已为 Chrome 和 Edge 注册}" Margin="0,2,0,0"/>
   </DockPanel>
   <DockPanel Margin="0,0,0,10" AutomationProperties.AutomationId="auv.claude.step2">
    <Grid DockPanel.Dock="Left"><Border Style="{StaticResource StepDone}" Visibility="{Binding ClaudeStep2Done, Converter={StaticResource Visible}}"><TextBlock Style="{StaticResource Tick}"/></Border><Border Style="{StaticResource StepTodo}" Visibility="{Binding ClaudeStep2Done, Converter={StaticResource InverseVisible}}"><TextBlock Text="2" Style="{StaticResource Number}"/></Border></Grid>
    <StackPanel>
     <TextBlock Text="{Binding ClaudeStep2Text}" Margin="0,2,0,0"/>
     <WrapPanel>
      <Button Content="{local:Tr 'Load in Chrome', 在 Chrome 中加载}" Tag="chrome" Click="Load_Click" Style="{StaticResource StepButton}" AutomationProperties.AutomationId="auv.claude.load-chrome"/>
      <Button Content="{local:Tr 'Load in Edge', 在 Edge 中加载}" Tag="edge" Click="Load_Click" Style="{StaticResource StepButton}" AutomationProperties.AutomationId="auv.claude.load-edge"/>
     </WrapPanel>
    </StackPanel>
   </DockPanel>
   <DockPanel AutomationProperties.AutomationId="auv.claude.step3">
    <Grid DockPanel.Dock="Left"><Border Style="{StaticResource StepDone}" Visibility="{Binding ClaudeStep3Done, Converter={StaticResource Visible}}"><TextBlock Style="{StaticResource Tick}"/></Border><Border Style="{StaticResource StepTodo}" Visibility="{Binding ClaudeStep3Done, Converter={StaticResource InverseVisible}}"><TextBlock Text="3" Style="{StaticResource Number}"/></Border></Grid>
    <StackPanel>
     <TextBlock Text="{Binding ClaudeStep3Text}" Margin="0,2,0,0"/>
     <WrapPanel><Button Content="{local:Tr 'Open claude.ai', 打开 claude.ai}" Click="OpenClaude_Click" Style="{StaticResource StepButton}" AutomationProperties.AutomationId="auv.claude.open-site"/></WrapPanel>
    </StackPanel>
   </DockPanel>
  </StackPanel>
  <!-- What to do next in the browser -->
  <Border Visibility="{Binding HasClaudeHint, Converter={StaticResource Visible}}" Background="{DynamicResource SelectionBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0" AutomationProperties.AutomationId="auv.claude.hint">
   <TextBlock Text="{Binding ClaudeHint}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <!-- Why the last sync failed, with the matching action -->
  <StackPanel Visibility="{Binding HasClaudeFailure, Converter={StaticResource Visible}}" Margin="0,12,0,0" AutomationProperties.AutomationId="auv.claude.failure">
   <TextBlock Text="{Binding ClaudeFailureText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
   <WrapPanel Visibility="{Binding HasClaudeRemedy, Converter={StaticResource Visible}}"><Button Content="{Binding ClaudeRemedyLabel}" Click="Remedy_Click" Style="{StaticResource StepButton}" AutomationProperties.AutomationId="auv.claude.remedy"/></WrapPanel>
  </StackPanel>
  <!-- A start-up update that did not complete -->
  <StackPanel Visibility="{Binding HasClaudeUpdateFailure, Converter={StaticResource Visible}}" Margin="0,12,0,0" AutomationProperties.AutomationId="auv.claude.update-failure">
   <TextBlock Text="{Binding ClaudeUpdateFailure}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
   <WrapPanel><Button Content="{local:Tr Retry, 重试}" Click="RetryUpdate_Click" Style="{StaticResource StepButton}" AutomationProperties.AutomationId="auv.claude.retry-update"/></WrapPanel>
  </StackPanel>
 </StackPanel>
</UserControl>
