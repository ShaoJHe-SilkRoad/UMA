<Window x:Class="AUV.Windows.App.UsageFlyout" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AUV.Windows.App" Style="{StaticResource {x:Type Window}}" Title="AUV — Tray Usage" Width="360" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True" AutomationProperties.AutomationId="auv.tray.flyout">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/><local:InverseVisibilityConverter x:Key="InverseVisible"/></Window.Resources>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Grid><TextBlock Text="Usage" FontSize="18" FontWeight="SemiBold"/><Button Content="×" HorizontalAlignment="Right" Padding="8,0" MinHeight="24" Click="Hide_Click" AutomationProperties.Name="Close usage popup"/></Grid><TextBlock Text="DEMO · Sample data" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,5,0,0" Visibility="{Binding Main.Demo, Converter={StaticResource Visible}}"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom">
    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,12"/>
    <Grid ToolTip="{Binding Performance.Updated}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><Grid><TextBlock Text="CPU" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Performance.CpuText}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><ProgressBar Value="{Binding Performance.CpuValue, Mode=OneWay}" Foreground="{DynamicResource ChartBrush}" Visibility="{Binding Performance.HasCpu, Converter={StaticResource Visible}}" Margin="0,5,0,0" Height="6"/></StackPanel><StackPanel Grid.Column="1"><Grid><TextBlock Text="RAM" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Performance.MemoryText}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><ProgressBar Value="{Binding Performance.MemoryValue, Mode=OneWay}" Foreground="{DynamicResource ChartBrush}" Visibility="{Binding Performance.HasMemory, Converter={StaticResource Visible}}" Margin="0,5,0,0" Height="6"/></StackPanel></Grid>
    <TextBlock Text="{Binding Performance.MemoryDetail}" FontSize="11" Style="{StaticResource Muted}" Margin="0,6,0,12"/>
    <CheckBox Content="Desktop Wizard" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding WidgetRequested, Mode=OneWay}" Click="Widget_Click" AutomationProperties.AutomationId="auv.flyout.widget"/>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Open AUV" Command="{Binding OpenCommand}"/><Button Grid.Column="2" Content="Quit" Command="{Binding QuitCommand}"/></Grid>
   </StackPanel>
   <Grid><TextBlock Text="No usage available" Style="{StaticResource Muted}" Margin="0,4,0,12" Visibility="{Binding Main.HasQuotaAgents, Converter={StaticResource InverseVisible}}"/><ListBox ItemsSource="{Binding Main.QuotaAgents}" SelectedItem="{Binding Main.Shell.SelectedAgent, Mode=TwoWay}" Visibility="{Binding Main.HasQuotaAgents, Converter={StaticResource Visible}}" AutomationProperties.Name="Tray agents"><ListBox.ItemTemplate><DataTemplate><local:AllowanceRow ShowFill="{Binding Desktop.ShowFill, Source={x:Static Application.Current}}" ShowStatus="{Binding Desktop.ShowStatus, Source={x:Static Application.Current}}" Card="{Binding Card}" Height="60"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
  </DockPanel>
 </Border>
</Window>
