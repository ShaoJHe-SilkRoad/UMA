{
  "manifest_version": 3,
  "name": "AUV Browser Companion for Claude",
  "version": "1.0.0",
  "description": "Reads Claude's plan-limit percentages from the official claude.ai Usage page for AUV on this computer. Nothing else is read.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "host_permissions": ["https://claude.ai/new*"],
  "background": {"service_worker": "background-loader.js"},
  "content_scripts": [{
    "matches": ["https://claude.ai/new*"],
    "js": [
      "Shared/claude-usage-extractor.js",
      "Shared/provider-ownership-v2.js",
      "Shared/content-script.js"
    ],
    "run_at": "document_start",
    "all_frames": false
  }],
  "action": {"default_title": "Sync Claude usage in AUV now", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
